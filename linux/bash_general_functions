#! /bin/bash

# Copy physical path to clipboard + act as an alias for `pwd -P`
pp() {
    local dir
    dir="$(pwd -P)"

    # stdout: value only (Compatible with '$(pp)' on command line)
    printf '%s\n' "$dir"

    # clipboard side-effect (fully detached, no job control)
    if [[ -z "${SSH_CLIENT:-}" ]]; then
        if command -v wl-copy >/dev/null; then
            printf '%s' "$dir" | setsid wl-copy >/dev/null 2>&1
        elif command -v xclip >/dev/null; then
            printf '%s' "$dir" | xclip -selection clipboard >/dev/null 2>&1
        elif command -v pbcopy >/dev/null; then
            printf '%s' "$dir" | pbcopy
        else
            echo "No clipboard utility found (wl-copy, xclip, or pbcopy)." >&2
        fi
    fi
}
